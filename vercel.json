{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "PORT=22434 BASE_PATH=/ pnpm --filter @workspace/kaspa-disperse run build",
  "outputDirectory": "artifacts/kaspa-disperse/dist/public",
  "rewrites": [
    {
      "source": "/api/app/:path*",
      "destination": "https://kcc-20-kron-trading-bot.replit.app/api/app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
